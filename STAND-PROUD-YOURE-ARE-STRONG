name: Build STEEL BALL RUN APK

on:
  push:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Find the project
        run: |
          if [ -f settings.gradle ]; then
            echo "PROJ=." >> "$GITHUB_ENV"
          else
            Z=$(ls ./*.zip | head -n 1)
            mkdir -p _project
            unzip -q -o "$Z" -d _project
            if [ ! -f _project/settings.gradle ]; then
              D=$(dirname "$(find _project -name settings.gradle | head -n 1)")
              echo "PROJ=$D" >> "$GITHUB_ENV"
            else
              echo "PROJ=_project" >> "$GITHUB_ENV"
            fi
          fi

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: android-actions/setup-android@v3

      - name: Get tag-reader library
        continue-on-error: true
        working-directory: ${{ env.PROJ }}
        run: |
          npm pack jsmediatags@3.9.7
          tar xzf jsmediatags-3.9.7.tgz package/dist/jsmediatags.min.js
          cp package/dist/jsmediatags.min.js app/src/main/assets/jsmediatags.min.js
          rm -rf package jsmediatags-3.9.7.tgz

      - name: Build APK
        working-directory: ${{ env.PROJ }}
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon --stacktrace
          cp app/build/outputs/apk/debug/app-debug.apk "$GITHUB_WORKSPACE/STEEL-BALL-RUN.apk"

      - uses: actions/upload-artifact@v4
        with:
          name: STEEL-BALL-RUN-apk
          path: STEEL-BALL-RUN.apk

      - name: Publish APK to Releases
        uses: softprops/action-gh-release@v2
        with:
          tag_name: apk-${{ github.run_number }}
          name: STEEL BALL RUN build ${{ github.run_number }}
          files: STEEL-BALL-RUN.apk
